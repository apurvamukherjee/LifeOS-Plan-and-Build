# Supabase (optional — the app runs fully offline/local-only without these set).
# Create a free project at https://supabase.com, then apply supabase/schema.sql to it.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push (optional, Stage 2 — no server exists yet to send pushes, this only
# enables the client-side subscription capture stub described in docs/ARCHITECTURE.md).
VITE_VAPID_PUBLIC_KEY=
